<hc:Window x:Class="LolSpeaker.Views.MainWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:local="clr-namespace:LolSpeaker"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:const="clr-namespace:LolSpeaker.Constants"
           xmlns:prism="http://prismlibrary.com/"
           xmlns:conv="clr-namespace:LolSpeaker.Views.Conveters"
           prism:ViewModelLocator.AutoWireViewModel="True"
           mc:Ignorable="d" WindowStartupLocation="CenterScreen"
           hc:Dialog.Token="{x:Static const:DialogTokens.MainWindow}"
           Title="{x:Static const:Titles.Main}" Height="320" Width="520" Icon="/Assets/Images/LOL_speaker.ico" StateChanged="Window_StateChanged" ResizeMode="CanMinimize">
  <Window.Resources>
    <Style x:Key="NotifyBtn"
           TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="100"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
    <conv:Bool2Brush x:Key="Bool2Brush"/>
  </Window.Resources>

  <hc:Window.NonClientAreaContent>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel
      VerticalAlignment="Stretch" Orientation="Horizontal" Margin="5,0,0,0">
        <Button Content="检查更新" ToolTip="{Binding Version}" Foreground="{Binding NeedUpdate,Converter={StaticResource Bool2Brush}}" BorderThickness="0" VerticalAlignment="Center" Command="{Binding UpdateCommand}"/>
        <Button
        BorderThickness="0" ToolTip="GitHub" Command="{Binding VisitGitHubCommand}" Margin="10,0,0,0">
          <Image Source="/Assets/Images/github.png"/>
        </Button>
      </StackPanel>
      <Button Content="词库设置" ToolTip="词库设置"
              Command="{Binding SetCommand}" Grid.Column="1" BorderThickness="0" Margin="0,0,5,0"/>
    </Grid>
  </hc:Window.NonClientAreaContent>

  <i:Interaction.Triggers>
    <i:EventTrigger EventName="Loaded">
      <i:InvokeCommandAction Command="{Binding LoadedCommand}"/>
    </i:EventTrigger>
  </i:Interaction.Triggers>

  <Grid>
    <hc:NotifyIcon
      Token="NotifyIconToken" x:Name="notifyIcon" Text="lol_speaker" IsBlink="{Binding IsNotifyIconBlink}" Visibility="{Binding IsNotifyIconShow,Converter={StaticResource Boolean2VisibilityConverter}}" MouseDoubleClick="Button_Click" Icon="/Assets/Images/LOL_speaker.ico">
      <hc:NotifyIcon.ContextContent>
        <Border CornerRadius="4" Margin="5" Effect="{StaticResource EffectShadow2}" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" >
          <StackPanel Margin="10" VerticalAlignment="Center">
            <Button Content="显示主界面" Click="Button_Click" Style="{StaticResource NotifyBtn}"/>
            <Button Content="退出" Click="Button_Quit_Click" Style="{StaticResource NotifyBtn}"/>
          </StackPanel>
        </Border>
      </hc:NotifyIcon.ContextContent>
    </hc:NotifyIcon>

    <Border Margin="10" BorderBrush="Black" BorderThickness="1,1,1,1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--表头放在滚动区里面，保证出现滚动条时列宽仍然对齐-->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid Background="#FFF0F0F0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="84"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="按键" Margin="0,5" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontStyle="Italic"/>
              <TextBlock Grid.Column="1" Text="绑定词库" Margin="0,5" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontStyle="Italic"/>
              <TextBlock Grid.Column="2" Text="范围" Margin="0,5" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontStyle="Italic"/>
              <TextBlock Grid.Column="3" Text="备注" Margin="0,5" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontStyle="Italic"/>
            </Grid>

            <ListBox Grid.Row="1" BorderThickness="0" Background="Transparent"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     ItemsSource="{Binding Library.KeyFunctions}"
                     SelectedItem="{Binding SelectedKeyFunction, Mode=TwoWay}">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListBoxItemBaseStyle}">
                  <Setter Property="Padding" Value="0"/>
                  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="46"/>
                      <ColumnDefinition Width="130"/>
                      <ColumnDefinition Width="84"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Key}" Margin="0,4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding CategoryName}" Margin="0,4" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <CheckBox Grid.Column="2" Content="{Binding ScopeText}" IsChecked="{Binding IsAll}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="选中=所有人，不选=队内"/>
                    <TextBlock Grid.Column="3" Text="{Binding Remark}" Margin="0,4" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
          <Button Content="增加按键功能" Command="{Binding AddKeyFunctionCommand}" Margin="0,0,10,0"/>
          <Button Content="修改" Command="{Binding EditKeyFunctionCommand}" Margin="0,0,10,0"/>
          <Button Content="删除" Command="{Binding DeleteKeyFunctionCommand}"/>
        </StackPanel>
      </Grid>
    </Border>


  </Grid>


</hc:Window>
