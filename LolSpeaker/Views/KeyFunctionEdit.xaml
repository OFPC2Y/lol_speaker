<UserControl x:Class="LolSpeaker.Views.KeyFunctionEdit"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:LolSpeaker.Views"
             xmlns:prism="http://prismlibrary.com/"
             mc:Ignorable="d"
             d:DesignHeight="280" d:DesignWidth="420">
  <prism:Dialog.WindowStyle>
    <Style TargetType="Window">
      <Setter Property="Height" Value="280"/>
      <Setter Property="Width" Value="420"/>
      <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen"/>
    </Style>
  </prism:Dialog.WindowStyle>

  <Grid Margin="15">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>

    <TextBlock Text="按键" VerticalAlignment="Center" Margin="0,0,10,0"/>
    <ComboBox Grid.Column="1" Margin="0,5" VerticalContentAlignment="Center"
              ItemsSource="{Binding Keys}"
              SelectedItem="{Binding Function.Key, UpdateSourceTrigger=PropertyChanged}"/>

    <TextBlock Grid.Row="1" Text="功能备注" VerticalAlignment="Center" Margin="0,0,10,0"/>
    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,5" VerticalContentAlignment="Center"
             Text="{Binding Function.Remark, UpdateSourceTrigger=PropertyChanged}"/>

    <TextBlock Grid.Row="2" Text="绑定词库" VerticalAlignment="Center" Margin="0,0,10,0"/>
    <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,5" VerticalContentAlignment="Center"
              ItemsSource="{Binding Categories}" DisplayMemberPath="CategoryName"
              SelectedValuePath="CategoryName"
              SelectedValue="{Binding Function.CategoryName, UpdateSourceTrigger=PropertyChanged}"/>

    <TextBlock Grid.Row="3" Text="范围" VerticalAlignment="Center" Margin="0,0,10,0"/>
    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,5">
      <RadioButton Content="队内" IsChecked="{Binding Function.IsTeam}" Margin="0,0,20,0"/>
      <RadioButton Content="所有人" IsChecked="{Binding Function.IsAll}"/>
    </StackPanel>

    <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="确认" Command="{Binding OkCommand}" IsDefault="True" Style="{StaticResource ButtonPrimary}" Width="100" Margin="0,0,10,0"/>
      <Button Content="取消" Command="{Binding CancelCommand}" IsCancel="True" Width="100"/>
    </StackPanel>
  </Grid>
</UserControl>
